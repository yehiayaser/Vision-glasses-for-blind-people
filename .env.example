# Eye-Know-You — Environment Template
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# All variables are optional — the defaults shown here match the project defaults.
# Any variable left unset will fall back to the default value defined in src/config.py.

# ── Camera ──────────────────────────────────────────────────────────────────
EKY_CAMERA_INDEX=0

# ── Face Recognition ─────────────────────────────────────────────────────────
EKY_FACE_TOLERANCE=0.5
EKY_FACE_MODEL=hog

# ── Object Detection ─────────────────────────────────────────────────────────
EKY_DETECTION_THRESHOLD=0.5

# ── Navigation ───────────────────────────────────────────────────────────────
EKY_FOCAL_LENGTH=820

# ── Audio ────────────────────────────────────────────────────────────────────
EKY_COOLDOWN_SECONDS=3

# ── Paths ────────────────────────────────────────────────────────────────────
EKY_RAW_DIR=data/raw
EKY_EMBEDDINGS_DIR=data/embeddings
EKY_DETECTION_MODEL=models/detection/yolov8n.pt
EKY_MODEL_HASH=f59b3d833e2ff32e194b5bb8e08d211dc7c5bdf144b90d2c8412c47ccfc83b36
